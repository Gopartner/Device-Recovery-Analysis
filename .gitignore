# ============================================
# TWRP Porting Toolkit - .gitignore
# ============================================

# Binary files (keep locally for TWRP porting)
*.img
*.bin
*.zip
*.tar.gz
*.tar.bz2

# Extracted binary files (large, keep locally)
device-analysis/04-boot-architecture/extracted/boot/kernel
device-analysis/04-boot-architecture/extracted/boot/ramdisk.cpio
device-analysis/04-boot-architecture/extracted/boot/dtb
device-analysis/04-boot-architecture/extracted/init_boot/ramdisk.cpio
device-analysis/04-boot-architecture/extracted/vendor_boot/ramdisk.cpio

# Work directory (generated files)
work/

# Raw dumps (documentation is in .md files)
mounts.txt
crypto-props.txt
fstab.txt
metadata-list.txt
display-info.txt
input-devices.txt
usb-config.txt

# Temporary files
*.tmp
*.log
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.sublime-*
